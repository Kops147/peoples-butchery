# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thepeoplesbutchery
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Server
NODE_ENV=production
PORT=3000
API_URL=https://api.thepeoplesbutchery.co.za

# JWT
JWT_SECRET=your_super_secure_jwt_secret_key_here_min_32_chars
JWT_EXPIRY=7d

# Client
CLIENT_URL=https://thepeoplesbutchery.co.za

# Admin
ADMIN_EMAIL=admin@thepeoplesbutchery.co.za
ADMIN_PIN=peoples2024

# Alibaba Cloud
ALIBABA_ACCESS_KEY_ID=your_access_key_id
ALIBABA_ACCESS_KEY_SECRET=your_access_key_secret
ALIBABA_REGION_ID=cn-hangzhou
ALIBABA_OSS_BUCKET=the-peoples-butchery-assets
ALIBABA_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIBABA_SMS_SIGN_NAME=PeoplesButchery
ALIBABA_SMS_TEMPLATE_CODE=SMS_123456789
